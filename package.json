{
  "name": "licketysplit",
  "version": "0.1.2",
  "private": true,
  "description": "LicketySplit video and media editing workspace",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @licketysplit/web dev",
    "build:wasm": "pnpm --filter @licketysplit/core build:wasm",
    "build": "pnpm build:wasm && pnpm --filter @licketysplit/web build",
    "preview": "pnpm --filter @licketysplit/web preview",
    "test": "pnpm -r test:run",
    "test:watch": "pnpm -r test",
    "lint": "pnpm -r lint",
    "check:mobile-offline": "node scripts/check-mobile-offline.mjs",
    "check:retired-cloud-gpu": "node scripts/check-retired-cloud-gpu.mjs",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "claude:help": "cat scripts/claude-review.md",
    "issues": "gh issue list --label needs-claude-review",
    "prs": "gh pr list --label needs-claude-review"
  },
  "keywords": [
    "video-editor",
    "audio-editor",
    "browser-based",
    "webcodecs",
    "webgpu",
    "react",
    "typescript",
    "open-source",
    "video-editing",
    "timeline",
    "color-grading",
    "export"
  ],
  "author": "heymrmom and contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/heymrmom/LicketySplit.git"
  },
  "bugs": {
    "url": "https://github.com/heymrmom/LicketySplit/issues"
  },
  "homepage": "https://github.com/heymrmom/LicketySplit",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.7.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@ffmpeg/core": "0.12.6",
    "@ffmpeg/core-mt": "0.12.6",
    "mediabunny": "^1.25.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@astryxdesign/cli": "^0.1.1"
  }
}
