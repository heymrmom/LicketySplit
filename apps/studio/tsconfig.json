{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "baseUrl": ".",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@licketysplit/core": ["../../packages/core/src/index.ts"],
      "@licketysplit/core/*": ["../../packages/core/src/*"],
      "@licketysplit/fxpkg": ["../../packages/fxpkg/src/index.ts"],
      "@licketysplit/fxpkg/*": ["../../packages/fxpkg/src/*"],
      "@licketysplit/ui": ["../../packages/ui/src/index.ts"],
      "@licketysplit/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
