{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@licketysplit/core": ["../../packages/core/src/index.ts"],
      "@licketysplit/core/*": ["../../packages/core/src/*"],
      "@licketysplit/agent": ["../../packages/agent/src/index.ts"],
      "@licketysplit/agent/*": ["../../packages/agent/src/*"],
      "@licketysplit/ui": ["../../packages/ui/src/index.ts"],
      "@licketysplit/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["src"]
}
